# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# --- Auth ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider ---
# Provider can be swapped without touching the code: gigachat | openai | deepseek
LLM_PROVIDER=gigachat
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Base64 "client_id:client_secret" from GigaChat Studio
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# --- Embeddings / vector store ---
# e5-models expect "query: " / "passage: " prefixes; quote values to keep the trailing space
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
FAISS_INDEX_PATH=./data/faiss_index
RETRIEVER_TOP_K=4
# Cosine floor tuned for e5-base: relevant pairs ~0.83-0.91, off-topic ~0.70-0.78
RETRIEVER_MIN_SCORE=0.8

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
