# Прод-окружение. Скопируйте в .env.prod и заполните:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# Файл .env.prod в git не попадает.

# --- Домен и TLS ---
# Домен должен уже указывать A-записью на этот сервер.
DOMAIN=rag.example.com
LETSENCRYPT_EMAIL=you@example.com

# --- База ---
POSTGRES_USER=rag
POSTGRES_DB=rag
# Сгенерируйте: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Приложение ---
APP_ENV=production
LOG_LEVEL=INFO
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_64_hex_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=20

# --- Модель ---
# gigachat | openai | deepseek
LLM_PROVIDER=gigachat
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# Ключ GigaChat: client_id:client_secret, base64 от него или готовый Authorization key
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# true — проверять TLS-сертификат GigaChat (в проде лучше true, если сертификат НУЦ Минцифры установлен в контейнере)
GIGACHAT_VERIFY_SSL_CERTS=false

# Ключ, если выбран openai/deepseek
LLM_API_KEY=

# --- Эмбеддинги и поиск ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
RETRIEVER_TOP_K=4
RETRIEVER_MIN_SCORE=0.8

# --- Загрузка документов ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
